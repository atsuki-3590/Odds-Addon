{
  "manifest_version": 3,
  "name": "オッズ歪みチェッカー",
  "version": "0.2.0",
  "description": "開いているオッズページを読み、同じ的中条件になる買い方の合成オッズ（2連単2点と2連複、3連単と3連複など）を比べてサイドパネルに表示します（自分用）。",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "オッズ歪みチェッカーを開く"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.boatrace.jp/owpc/pc/race/odds2tf*",
        "https://www.boatrace.jp/owpc/pc/race/odds3t*",
        "https://www.boatrace.jp/owpc/pc/race/odds3f*",
        "https://www.boatrace.jp/owpc/pc/race/oddsk*"
      ],
      "js": [
        "src/parser.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
